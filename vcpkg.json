{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "heartstead",
  "version-string": "0.1.0",
  "description": "Heartstead custom engine foundation",
  "builtin-baseline": "b81cab76a175645e047601da8f982ad86bff1cc3",
  "dependencies": [
    {
      "name": "joltphysics",
      "default-features": false
    },
    "draco",
    "fastgltf",
    {
      "name": "glslang",
      "host": true,
      "features": [
        "tools"
      ]
    },
    "ktx",
    "meshoptimizer",
    "miniaudio",
    "stb",
    {
      "name": "luau",
      "default-features": false
    }
  ],
  "features": {
    "profiling": {
      "description": "Opt-in Tracy client instrumentation for profile builds",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "on-demand"
          ]
        }
      ]
    }
  },
  "overrides": [
    {
      "name": "joltphysics",
      "version": "5.6.0"
    },
    {
      "name": "fastgltf",
      "version": "0.9.0"
    },
    {
      "name": "draco",
      "version": "1.5.7",
      "port-version": 1
    },
    {
      "name": "ktx",
      "version": "4.4.2"
    },
    {
      "name": "meshoptimizer",
      "version": "1.2"
    },
    {
      "name": "miniaudio",
      "version": "0.11.25"
    },
    {
      "name": "luau",
      "version": "0.729"
    }
  ]
}
